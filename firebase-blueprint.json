{
  "entities": {
    "products": {
      "title": "Danh sách hàng hóa",
      "description": "Bảng quản lý danh sách sản phẩm và hàng hóa vật liệu chống thấm",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID sản phẩm" },
        "loaiHang": { "type": "string", "description": "Loại hàng (Dịch vụ / Hàng hóa)" },
        "nhomHang": { "type": "string", "description": "Nhóm hàng 3 cấp" },
        "code": { "type": "string", "description": "Mã hàng (Mã SKU)" },
        "maVach": { "type": "string", "description": "Mã vạch" },
        "name": { "type": "string", "description": "Tên sản phẩm / hàng hóa" },
        "brand": { "type": "string", "description": "Thương hiệu" },
        "price": { "type": "number", "description": "Giá bán (VNĐ)" },
        "costPrice": { "type": "number", "description": "Giá vốn (VNĐ)" },
        "stock": { "type": "number", "description": "Tồn kho" },
        "unit": { "type": "string", "description": "Đơn vị tính (ĐVT)" },
        "maDvtCoBan": { "type": "string", "description": "Mã ĐVT cơ bản" },
        "quyDoi": { "type": "number", "description": "Tỷ lệ quy đổi" },
        "imageUrl": { "type": "string", "description": "Đường dẫn hình ảnh" },
        "tichDiem": { "type": "number", "description": "Cho phép tích điểm (1: Có, 0: Không)" },
        "dangKinhDoanh": { "type": "number", "description": "Đang kinh doanh (1: Có, 0: Không)" },
        "duocBanTrucTiep": { "type": "number", "description": "Được bán trực tiếp (1: Có, 0: Không)" },
        "description": { "type": "string", "description": "Mô tả sản phẩm" },
        "location": { "type": "string", "description": "Vị trí trong kho" },
        "createdAt": { "type": "string", "description": "Thời gian tạo" },
        "updatedAt": { "type": "string", "description": "Thời gian cập nhật" }
      },
      "required": ["code", "name", "price", "unit"]
    },
    "orders": {
      "title": "Danh sách Hóa đơn",
      "description": "Bảng quản lý danh sách hóa đơn và đơn bán hàng",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID hóa đơn" },
        "orderCode": { "type": "string", "description": "Mã hóa đơn (VD: HD009721)" },
        "date": { "type": "string", "description": "Thời gian (VD: 07/08/2026 10:03:12)" },
        "returnCode": { "type": "string", "description": "Mã trả hàng" },
        "customerCode": { "type": "string", "description": "Mã khách hàng (VD: KH000009)" },
        "customerName": { "type": "string", "description": "Tên khách hàng" },
        "subtotal": { "type": "number", "description": "Tổng tiền hàng" },
        "discount": { "type": "number", "description": "Giảm giá" },
        "totalAmount": { "type": "number", "description": "Tổng sau giảm giá" },
        "amountPaid": { "type": "number", "description": "Khách đã trả" },
        "itemsCount": { "type": "number", "description": "Số lượng mặt hàng" },
        "paymentMethod": { "type": "string", "description": "Phương thức thanh toán" },
        "status": { "type": "string", "description": "Trạng thái đơn hàng" },
        "note": { "type": "string", "description": "Ghi chú đơn hàng" },
        "createdAt": { "type": "string", "description": "Thời gian tạo" }
      },
      "required": ["orderCode", "date", "customerName", "totalAmount"]
    },
    "suppliers": {
      "title": "Danh sách Nhà cung cấp",
      "description": "Bảng quản lý danh sách nhà cung cấp",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID nhà cung cấp" },
        "code": { "type": "string", "description": "Mã nhà cung cấp (VD: NCC000048)" },
        "name": { "type": "string", "description": "Tên nhà cung cấp" },
        "phone": { "type": "string", "description": "Điện thoại" },
        "email": { "type": "string", "description": "Email" },
        "currentDebt": { "type": "number", "description": "Nợ cần trả hiện tại" },
        "totalPurchased": { "type": "number", "description": "Tổng mua" },
        "address": { "type": "string", "description": "Địa chỉ" },
        "note": { "type": "string", "description": "Ghi chú" },
        "createdAt": { "type": "string", "description": "Thời gian tạo" }
      },
      "required": ["code", "name"]
    },
    "customers": {
      "title": "Danh sách Khách hàng",
      "description": "Bảng quản lý danh sách khách hàng",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID khách hàng" },
        "code": { "type": "string", "description": "Mã khách hàng (VD: KH000100)" },
        "name": { "type": "string", "description": "Tên khách hàng" },
        "phone": { "type": "string", "description": "Điện thoại" },
        "email": { "type": "string", "description": "Email" },
        "address": { "type": "string", "description": "Địa chỉ" },
        "creator": { "type": "string", "description": "Người tạo" },
        "customerGroup": { "type": "string", "description": "Nhóm khách hàng" },
        "totalSpent": { "type": "number", "description": "Tổng bán" },
        "orderCount": { "type": "number", "description": "Số lượng đơn hàng" },
        "debt": { "type": "number", "description": "Nợ cần thu hiện tại" },
        "points": { "type": "number", "description": "Điểm thưởng" },
        "createdAt": { "type": "string", "description": "Thời gian tạo" }
      },
      "required": ["code", "name"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "products",
      "description": "Danh sách sản phẩm"
    },
    "/orders/{orderId}": {
      "schema": "orders",
      "description": "Danh sách hóa đơn bán hàng"
    },
    "/suppliers/{supplierId}": {
      "schema": "suppliers",
      "description": "Danh sách nhà cung cấp"
    },
    "/customers/{customerId}": {
      "schema": "customers",
      "description": "Danh sách khách hàng"
    }
  }
}
